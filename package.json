{
	"name": "foneazmi.github.io",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler pages deploy dist && gh-pages -d dist",
		"cf-typegen": "wrangler types",
		"test": "vitest",
